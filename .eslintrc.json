{
    "root": true,
    "env": {
        "node": true,
        "es2022": true,
        "jest": true
    },
    "extends": [
        "eslint:recommended"
    ],
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "script"
    },
    "ignorePatterns": [
        "node_modules/",
        "coverage/"
    ],
    "rules": {
        "no-console": "off"
    }
}