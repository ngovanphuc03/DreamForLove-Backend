# ── Server ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── PostgreSQL ────────────────────────────────────────────────
# OPTION A: Cloud DB URL (Aiven / Supabase / Railway) — dán URL vào đây
# Ví dụ Aiven:   postgres://avnadmin:password@your-service.aivencloud.com:18110/defaultdb?sslmode=require&uselibpqcompat=true
# Ví dụ Supabase: postgres://postgres:pass@db.xxx.supabase.co:5432/postgres
DATABASE_URL=

# ── One-time DB migration to Aiven (optional) ────────────────
# Source DB chứa dữ liệu cũ (nếu để trống sẽ dùng DB_* bên dưới)
MIGRATION_SOURCE_DATABASE_URL=
# Target DB (Aiven). Nếu để trống sẽ dùng DATABASE_URL
MIGRATION_TARGET_DATABASE_URL=

# OPTION B: Localhost (dùng khi DATABASE_URL để trống)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dreamforlove
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_SSL=false

# ── Firebase Admin SDK ────────────────────────────────────────
# Download from Firebase Console → Project Settings → Service Accounts
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=your_private_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END RSA PRIVATE KEY-----"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your_client_id

# ── JWT / Security ────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
SESSION_SECRET=your_session_secret_here

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ── Free Tier Limits ──────────────────────────────────────────
FREE_WISHLIST_LIMIT=10
FREE_FOOD_LIMIT=5

# ── Soft Delete Retention ─────────────────────────────────────
DATA_RETENTION_DAYS=30

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=debug
